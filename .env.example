# API Server URL
# For development: leave blank to use relative URLs (server runs on same port as client)
# For production: set to your Render server URL (e.g., https://addcontact-server.onrender.com)
VITE_API_URL=

# Zapier integration page
VITE_ZAPIER_INVITE_URL=https://zapier.com/developer/public-invite/240507/da63c72aee602b7838b5e5b8d6d72396/
VITE_ZAPIER_APP_CLI_NAME=

# Server-side environment variables (not used by client)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# Zapier private app integration
ZAPIER_INVITE_URL=https://zapier.com/developer/public-invite/240507/da63c72aee602b7838b5e5b8d6d72396/
ZAPIER_KEY_PREFIX=zap_live_

DATABASE_URL=
JWT_SECRET=

# Internal server-to-server API key used by n8n to call /api/n8n/* endpoints.
# Must match the key stored in n8n's credential vault (Authorization: Internal-Key <key>).
# Requests must also be HMAC-SHA256 signed (X-Signature-256 header).
INTERNAL_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# n8n Webhook URL for S&G Link form submissions
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id
# GHL workflow "Webhook" actions posted to {{custom_values.homeflow_webhook}} are relayed here
GHL_WORKFLOW_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-quote-router-id

# App Domain URL for GHL sidebar integration (e.g. https://your-app.vercel.app)
APP_DOMAIN=https://homeflow-suite.vercel.app
VITE_APP_DOMAIN=https://homeflow-suite.vercel.app
# Public backend origin used to build per-location custom-trigger webhook URLs.
# For split frontend/backend deployments, use the backend URL here.
CUSTOM_TRIGGER_WEBHOOK_BASE_URL=https://your-backend.example.com
# Configure the same secret in the HighLevel Marketplace custom trigger Subscription URL headers
# as X-Homeflow-Subscription-Secret. Leave blank only for initial local testing.
CUSTOM_TRIGGER_SUBSCRIPTION_SECRET=




# ── Security (all opt-in: nothing is enforced until a value is set) ──────────
# HighLevel Marketplace app → Advanced Settings → Auth → Shared Secret (SSO key).
# When set, every location-scoped API call requires a HighLevel SSO session,
# and users can only act on their own location (agency users: their company's).
GHL_APP_SSO_KEY=
# enforce (default) | report (log violations only, use to verify a rollout) | off
HOMEFLOW_AUTH_MODE=enforce
# HighLevel webhook public key (PEM; \n escapes allowed). When set, unsigned or
# invalid /api/ghl/webhook calls are rejected. Without it, an UNINSTALL event
# is only honoured if the stored token has really stopped working.
GHL_WEBHOOK_PUBLIC_KEY=
# Secret for the SMS custom action endpoints. Add it to the action URLs in the
# Marketplace app as ?secret=<value> (or header X-Homeflow-Action-Secret).
GHL_CUSTOM_ACTION_SECRET=
# Optional: pin the OAuth redirect URI instead of deriving it from the request.
GHL_OAUTH_REDIRECT_URI=
